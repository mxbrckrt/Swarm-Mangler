                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 7.0, 1043.0, 35.0, 22.0 ],
                    "text": "out 1"
                }
            }
        ],
