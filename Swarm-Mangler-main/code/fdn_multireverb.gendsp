        "righttoolbarpinned": 2,
        "bottomtoolbarpinned": 2,
        "boxes": [
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 28.0, 24.0, 185.0, 22.0 ],
                    "text": "in 1 @comment \"Audio In (MC)\""
                }
            },
            {
                "box": {
                    "code": "// =============================================================================\n// MULTICHANNEL SPATIAL FEEDBACK DELAY NETWORK (FDN) REVERBERATOR\n// Author: Max Bruckert (2026)\n// =============================================================================\n// An immersive, highly musical Feedback Delay Network (FDN) reverberator\n// engineered specifically for multichannel diffusion and spatial acoustics (mc.gen~).\n//\n// Musical & Acoustic Character:\n// - Lush, continuous, and highly organic reverberant field tailored for spatial speaker arrays.\n// - Prime-interval delay network with incommensurate golden-ratio inter-channel detuning,\n//   eliminating discrete modal resonances and flutter echoes across any multichannel ring.\n// - Rotating multiphase circular LFO modulation, injecting a silky, shimmering pitch-chorus\n//   and subtle physical movement through space with zero inter-channel phase cancellation.\n// - 4-phase cyclic orthogonal Hadamard output tapping, ensuring pristine spatial decorrelation\n//   between neighboring and opposing loudspeakers while preserving perfect mono-compatibility.\n// - Internal non-linear tanh() soft-clipping saturation inside the feedback matrix,\n//   enabling warm harmonic coloration and musical, bounded infinite self-oscillation.\n// - Per-channel spectral Tilt EQ and one-pole high-frequency absorption damping.\n//\n// Inlets:\n//   in1 : Multichannel Audio Input (mc.gen~ stream or distributed mono source)\n// Outlets:\n//   out1 : Multichannel Reverberant Audio Output\n// =============================================================================\n\nParam size(90, min=0.5, max=100);              // Perceived room geometry & delay scale\nParam decay(82, min=0, max=110);             // Reverb decay time (100 = infinite feedback threshold)\nParam spread(90, min=0, max=100);            // Inter-channel spatial decorrelation & multiphase depth\nParam absorb(10, min=0, max=100);            // High-frequency absorption (damping)\nParam tilt(-0.1, min=-1, max=1);             // Spectral tilt balance (-1 = dark, +1 = bright)\nParam predelay(10, min=0, max=100);          // Initial acoustic pre-delay (ms)\nParam speed(1, min=0.1, max=10);             // LFO modulation frequency (Hz)\nParam depth(5, min=0, max=20);               // LFO modulation intensity / spatial chorus depth\nParam mix_rev(25, name=\"mix\", min=0, max=100); // Dry/Wet mix balance (%)\n\n// --- Per-Voice Delay Memories & History Registers (mc.gen~ voice allocation) ---\nDelay d1(15000), d2(15000), d3(15000), d4(15000);\nDelay ap1(2000), ap2(2000), pre_dly(9600);\nHistory h1(0), h2(0), h3(0), h4(0); \nHistory h_lp(0), h_ph(0);\n\n// -----------------------------------------------------------------------------\n// 1. MULTICHANNEL GEOMETRY & SPATIAL DECORRELATION\n// -----------------------------------------------------------------------------\nn_chans  = max(1, mc_channelcount);\nch_idx   = mc_channel - 1; // 0-based channel index\nch_pos   = (n_chans > 1) ? (ch_idx / n_chans) : 0.0;\ns_spread = spread * 0.01;\n\n// Incommensurate golden-ratio prime detuning factor across loudspeaker channels\nch_detune = sin((ch_idx + 1) * 1.6180339887) * 0.06 * s_spread;\n\n// Smooth size slewing to avoid artifacts during dynamic modulation\ns_size = slide(size / 100, 2000, 2000);\n\n// Multiphase circular LFO: progressive spatial phase rotation across speakers\nh_ph   = wrap(h_ph + speed / samplerate, 0, 1);\nlfo_ph = wrap(h_ph + (ch_pos * s_spread), 0, 1);\nlfo    = sin(lfo_ph * TWOPI) * (depth * 5);\n\n// Channel-specific delay scaling\nscale_ch = s_size * (1.0 + ch_detune);\n\n// Prime delay times detuned per channel\nt1 = clamp(1531 * scale_ch + lfo, 10, 14000);\nt2 = clamp(2237 * scale_ch - lfo, 10, 14000);\nt3 = clamp(3163 * scale_ch + lfo, 10, 14000);\nt4 = clamp(4453 * scale_ch - lfo, 10, 14000);\n\n// -----------------------------------------------------------------------------\n// 2. INPUT PRE-DELAY & ALL-PASS DIFFUSION\n// -----------------------------------------------------------------------------\nsig_in = in1;\np_sig  = pre_dly.read(mstosamps(predelay));\npre_dly.write(sig_in);\n\n// Decorrelated input all-pass diffusion cascade\nap1_time = 400 * s_size * (1.0 + ch_detune * 0.5);\nap2_time = 600 * s_size * (1.0 - ch_detune * 0.5);\n\nv_ap1 = p_sig - ap1.read(ap1_time) * 0.6; \nap1.write(v_ap1); \ndf1 = ap1.read(ap1_time) + v_ap1 * 0.6;\n\nv_ap2 = df1 - ap2.read(ap2_time) * 0.6; \nap2.write(v_ap2); \ndiff_in = ap2.read(ap2_time) + v_ap2 * 0.6;\n\n// -----------------------------------------------------------------------------\n// 3. FDN CORE MATRIX (UNITARY HADAMARD & SOFT SATURATION)\n// -----------------------------------------------------------------------------\nfb_amount = decay / 100; \ndamp      = absorb / 100;\n\n// Read delay lines\nr1 = d1.read(t1); \nr2 = d2.read(t2); \nr3 = d3.read(t3); \nr4 = d4.read(t4);\n\n// 4x4 Hadamard Matrix (Unitary Gain: 1/sqrt(4) = 0.5)\nj1 = (r1 + r2 + r3 + r4) * 0.5;\nj2 = (r1 - r2 + r3 - r4) * 0.5;\nj3 = (r1 + r2 - r3 - r4) * 0.5;\nj4 = (r1 - r2 - r3 + r4) * 0.5;\n\n// High-frequency absorption (damping one-pole lowpass)\nh1 = mix(j1, h1, damp);\nh2 = mix(j2, h2, damp);\nh3 = mix(j3, h3, damp);\nh4 = mix(j4, h4, damp);\n\n// Feedback write with internal soft saturation (tanh) and DC blocking\nd1.write(fixdenorm(dcblock(diff_in + tanh(h1 * fb_amount))));\nd2.write(fixdenorm(dcblock(diff_in + tanh(h2 * fb_amount))));\nd3.write(fixdenorm(dcblock(diff_in + tanh(h3 * fb_amount))));\nd4.write(fixdenorm(dcblock(diff_in + tanh(h4 * fb_amount))));\n\n// -----------------------------------------------------------------------------\n// 4. ORTHOGONAL TAPPING & SPECTRAL TILT FILTERING\n// -----------------------------------------------------------------------------\n// Cyclic orthogonal extraction among Hadamard basis combinations\ntap = ch_idx % 4;\nraw = (r1 + r3) * 0.5;\nif (tap == 1) {\n    raw = (r2 + r4) * 0.5;\n} else if (tap == 2) {\n    raw = (r1 - r4) * 0.5;\n} else if (tap == 3) {\n    raw = (r2 - r3) * 0.5;\n}\n\n// Spectral Tilt EQ per voice\nt_lp = mix(raw, h_lp, 0.1); \nh_lp = t_lp;\n\nres = (tilt < 0) ? mix(raw, t_lp, abs(tilt)) : mix(raw, raw - t_lp, tilt);\n\n// Final output: Dry/Wet balance with safety soft-limiting\nout1 = tanh(mix(in1, res, mix_rev / 100));",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 28.0, 53.0, 849.0, 921.0 ]
                }
