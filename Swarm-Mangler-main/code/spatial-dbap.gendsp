            {
                "box": {
                    "id": "obj-codebox",
                    "maxclass": "codebox",
                    "code": "/**\n * ============================================================================\n * @file spatial-dbap.gendsp\n * @title MULTICHANNEL 3D DISTANCE-BASED AMPLITUDE PANNING (DBAP & KNN)\n * @author Max Bruckert (assisted by Gemini)\n *\n * @description\n * High-performance, sample-accurate 3D Distance-Based Amplitude Panning (DBAP)\n * with dynamic K-Nearest Neighbors (KNN) focus tapering, air absorption damping,\n * coordinate smoothing, and aperture width control.\n * Designed specifically for Max/MSP multichannel [mc.gen~].\n *\n * Evaluated per speaker channel (mc_channel). Reads arbitrary 3D speaker\n * coordinates from external 3-channel buffer~ \"spk_pos\" (Ch1: X, Ch2: Y, Ch3: Z)\n * loaded by dbap_csv_loader.js (centered on ear level Z=0, ADM convention).\n * Conserves acoustic power across arbitrary 2D/3D layouts.\n *\n * @inlets\n *   in 1 : Audio Signal (Mono Voice Source)\n *   in 2 : Source X Position (-1..1 normalized)\n *   in 3 : Source Y Position (-1..1 normalized)\n *   in 4 : Source Z Position (-1..1 normalized, 0 = ear level)\n *\n * @outlets\n *   out 1 : Spatialized audio stream for current MC channel (mc_channel)\n * ============================================================================\n */\n\nBuffer spk_pos;\n\n// Parameters (aligned with adm_panner)\nParam num_speakers(0, min=0, max=32);      // Active speaker count (0 = auto from mc_channelcount)\nParam rolloff(1.0, min=0.1, max=4.0);     // Base distance attenuation exponent\nParam blur(0.25, min=0.01, max=2.0);      // Source virtual radius / anti-singularity (meters)\nParam focus(0.0, min=0.0, max=1.0);       // KNN focus tapering (0 = diffuse DBAP, 1 = tight KNN)\nParam room_scale(2.0, min=0.1, max=20.0); // Room radius scale multiplier in meters\nParam smooth(240, min=1);                 // Coordinate slewing in samples (~5 ms at 48 kHz)\nParam width(100.0, min=1.0, max=200.0);   // Aperture beam width (100% = normal, 20% = pinpoint, 200% = wide)\nParam sharpness(1.0, min=0.5, max=4.0);   // Focal sharpness exponent (1.0 = gentle, 2.5 = crisp, 4.0 = razor)\nParam air_damp(0.0, min=0.0, max=1.0);    // High-frequency air absorption (0.0 = off, 1.0 = deep damp)\n\n// State history for air absorption 1-pole filter\nHistory prev_filtered(0.0);\n\n// Internal computation buffers (per channel instance)\nData dists(32);\n\n// 1. Multichannel speaker count and channel indexing\ntotal_spk = (num_speakers > 0) ? clamp(floor(num_speakers), 1, 32) : max(2, mc_channelcount);\nmy_idx    = mc_channel - 1; // 0-based channel index [0 .. total_spk - 1]\n\n// 2. Responsive coordinate slewing (anti-zipper noise)\nx_s = slide(in2, smooth, smooth);\ny_s = slide(in3, smooth, smooth);\nz_s = slide(in4, smooth, smooth);\n\n// 3. Metric room scaling and aperture width shaping\nsrc_x = x_s * room_scale;\nsrc_y = y_s * room_scale;\nsrc_z = z_s * room_scale;\n\nw_factor = clamp(width * 0.01, 0.05, 2.0);\neff_blur = blur * w_factor;\neff_roll = rolloff * sharpness;\n\nhas_buf = (dim(spk_pos) >= total_spk);\n\n// 4. Pass 1: Euclidean distance calculation and min/max search\nmin_d = 10000.0;\nmax_d = 0.0001;\nmy_d  = 10000.0;\nsx    = 0.0;\nsy    = 0.0;\nsz    = 0.0;\n\nfor (k = 0; k < total_spk; k += 1) {\n    fb_ang = k * (6.283185307179586 / total_spk);\n    fb_x   = 2.0 * sin(fb_ang);\n    fb_y   = 2.0 * cos(fb_ang);\n    fb_z   = 0.0;\n\n    sx = has_buf ? peek(spk_pos, k, 0) : fb_x;\n    sy = has_buf ? peek(spk_pos, k, 1) : fb_y;\n    sz = has_buf ? peek(spk_pos, k, 2) : fb_z;\n    \n    dx = src_x - sx;\n    dy = src_y - sy;\n    dz = src_z - sz;\n    d  = sqrt(dx*dx + dy*dy + dz*dz + eff_blur*eff_blur);\n    \n    poke(dists, d, k);\n    min_d = min(min_d, d);\n    max_d = max(max_d, d);\n    \n    if (k == my_idx) {\n        my_d = d;\n    }\n}\n\n// 5. Pass 2: DBAP weight calculation, KNN focus tapering, and energy summation\nspan   = max(max_d - min_d, 0.0001);\nenergy = 0.0;\nmy_w   = 0.0;\n\nfor (k = 0; k < total_spk; k += 1) {\n    d = peek(dists, k);\n    w = pow(d, -eff_roll);\n    \n    // KNN / focus tapering\n    if (focus > 0.0) {\n        rel_d = (d - min_d) / span;\n        taper = clamp(1.0 - (focus * rel_d * 1.5), 0.0, 1.0);\n        w     = w * taper;\n    }\n    \n    if (k == my_idx) {\n        my_w = w;\n    }\n    \n    energy += w * w;\n}\n\n// 6. Equal power normalization (sum g^2 = 1.0)\nnorm_factor = 1.0 / sqrt(max(energy, 1e-12));\n\n// If channel index exceeds active speaker count, zero gain\ngain_target = (my_idx < total_spk) ? (my_w * norm_factor) : 0.0;\n\n// 7. Acoustic atmospheric air absorption (ISO 9613-1 approximation)\naudio_out = in1 * gain_target;\n\nif (air_damp > 0.0) {\n    d_norm = clamp(my_d / max(room_scale, 0.1), 0.0, 2.0);\n    min_cutoff = 2500.0;\n    max_cutoff = 20000.0;\n    cutoff_target = clamp(max_cutoff - (d_norm * d_norm * air_damp * (max_cutoff - min_cutoff)), min_cutoff, max_cutoff);\n    w_rad = (6.283185307179586 * cutoff_target) / samplerate;\n    alpha = clamp(w_rad / (w_rad + 1.0), 0.001, 1.0);\n    filtered = (audio_out * alpha) + (prev_filtered * (1.0 - alpha));\n    prev_filtered = filtered;\n    out1 = filtered;\n} else {\n    out1 = audio_out;\n}\n",
                    "numinlets": 4,
                    "numoutlets": 1,
                    "outlettype": [
                        ""
                    ],
                    "patching_rect": [
                        30.0,
                        60.0,
                        910.0,
                        680.0
                    ]
                }
